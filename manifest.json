{
  "manifest_version": 3,
  "name": "Extensão Dark com IA",
  "version": "4.3.3",
  "description": "Modo escuro dirigido por mini redes neurais: a IA lê cada página e decide tudo.",
  "permissions": ["storage", "activeTab", "downloads"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Extensão Dark com IA",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["weights-page.js", "weights-images.js", "weights-region.js", "nn.js", "darl-features.js", "element.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Ativa ou desativa o modo escuro em todos os sites"
    }
  }
}
